{
  "$schema": "https://json.schemastore.org/launchsettings.json",
    "profiles": {
      "http": {
        "commandName": "Project",
        "dotnetRunMessages": true,
        "launchBrowser": true,
        "launchUrl": "swagger",
        "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}",
        "applicationUrl": "http://localhost:5152",
        "environmentVariables": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ConnectionStrings__DefaultConnection": "Host=localhost;Port=5432;Database=Avallo;Username=Avallo_app;Password=Avallo_app;Maximum Pool Size=300",
          "ConnectionStrings__MigrationConnection": "Host=localhost;Port=5432;Database=Avallo;Username=postgres;Password=postgres",
          "ObjectStorage__Enabled": "true",
          "ObjectStorage__Provider": "s3",
          "ObjectStorage__ServiceUrl": "http://localhost:9000",
          "ObjectStorage__AccessKey": "avallo",
          "ObjectStorage__SecretKey": "avallo-dev-key",
          "ObjectStorage__ContainerName": "uploads"
        }
      },
      "https": {
        "commandName": "Project",
        "dotnetRunMessages": true,
        "launchBrowser": true,
        "launchUrl": "swagger",
        "inspectUri": "{wsProtocol}://{url.hostname}:{url.port}/_framework/debug/ws-proxy?browser={browserInspectUri}",
        "applicationUrl": "https://localhost:7128;http://localhost:5152",
        "environmentVariables": {
          "ASPNETCORE_ENVIRONMENT": "Development",
          "ConnectionStrings__DefaultConnection": "Host=localhost;Port=5432;Database=Avallo;Username=Avallo_app;Password=Avallo_app;Maximum Pool Size=300",
          "ConnectionStrings__MigrationConnection": "Host=localhost;Port=5432;Database=Avallo;Username=postgres;Password=postgres",
          "ObjectStorage__Enabled": "true",
          "ObjectStorage__Provider": "s3",
          "ObjectStorage__ServiceUrl": "http://localhost:9000",
          "ObjectStorage__AccessKey": "avallo",
          "ObjectStorage__SecretKey": "avallo-dev-key",
          "ObjectStorage__ContainerName": "uploads"
        }
      }
    }
  }
