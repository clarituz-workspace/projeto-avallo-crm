{
  "Connectors": {
    "LoadPlugins": true,
    "PluginPath": "connectors"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=Avallo;Username=Avallo_app;Password=Avallo_app;Maximum Pool Size=300",
    "MigrationConnection": "Host=localhost;Port=5432;Database=Avallo;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Key": "development-only-key-change-before-production-2026-64-characters-long"
  },
  "Database": {
    "ApplyMigrations": true
  },
  "ObjectStorage": {
    "Enabled": true,
    "Provider": "s3",
    "ServiceUrl": "http://localhost:9000",
    "AccessKey": "avallo",
    "SecretKey": "avallo-dev-key",
    "ContainerName": "uploads",
    "DownloadUrlMinutes": 10
  },
  "AzureAI": {
    "Endpoint": "https://viniciusmoreira-7413-resource.services.ai.azure.com/openai/v1",
    "Deployment": "Phi-4-mini-instruct",
    "Scope": "https://ai.azure.com/.default",
    "ManagedIdentityClientId": "",
    "MaxOutputTokens": 800,
    "Temperature": 0.3
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
